    "name": "Community Waste Collection API",
    "description": "Health and Household API checkpoint. Start Docker Compose before running. The Households folder creates and deletes its own record; existing records are preserved. Run requests in order. Pickup, payment, and reporting endpoints are added in later checkpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
