    {
      "name": "Households",
      "description": "Run this folder in order. Four endpoints with positive and negative cases. It creates and removes its own household.",
      "item": [
        {
          "name": "Create household",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/households",
            "description": "Required nonblank owner_name and address. Surrounding whitespace is trimmed. Stores the generated UUID for subsequent requests.",
            "body": {
              "mode": "raw",
              "raw": "{\"owner_name\":\"  Ayu  \",\"address\":\"Jl. Merdeka 1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('household_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('JSON content type', function () { pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json'); });",
                  "const household = pm.response.json().data;",
                  "pm.test('Generated UUID', function () { pm.expect(household.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/); });",
                  "pm.test('Fields and timestamps', function () { pm.expect(household.owner_name).to.eql('Ayu'); pm.expect(household.address).to.eql('Jl. Merdeka 1'); pm.expect(household.created_at).to.be.a('string'); pm.expect(household.updated_at).to.eql(household.created_at); });",
                  "pm.test('Resource Location', function () { pm.expect(pm.response.headers.get('Location')).to.eql('/api/households/' + household.id); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('household_id', household.id); }"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Create household",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{base_url}}/api/households",
                "description": "Required nonblank owner_name and address. Surrounding whitespace is trimmed. Stores the generated UUID for subsequent requests.",
                "body": {
                  "mode": "raw",
                  "raw": "{\"owner_name\":\"  Ayu  \",\"address\":\"Jl. Merdeka 1\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": {\n    \"id\": \"10000000-0000-4000-8000-000000000001\",\n    \"owner_name\": \"Ayu\",\n    \"address\": \"Jl. Merdeka 1\",\n    \"created_at\": \"2026-01-01T00:00:00Z\",\n    \"updated_at\": \"2026-01-01T00:00:00Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "List households",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/households",
            "description": "Defaults: page=1, limit=20. Sorted by created_at DESC, id DESC. Existing records are allowed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON content type', function () { pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json'); });",
                  "pm.test('List metadata', function () { const body = pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta.page).to.eql(1); pm.expect(body.meta.limit).to.eql(20); pm.expect(body.meta.total).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginate households",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/households?page=1&limit=1",
            "description": "Positive integer page and limit, maximum limit 100. Count and rows use the same database snapshot."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON content type', function () { pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json'); });",
                  "pm.test('Requested page size', function () { const body = pm.response.json(); pm.expect(body.data).to.have.lengthOf(1); pm.expect(body.meta.page).to.eql(1); pm.expect(body.meta.limit).to.eql(1); pm.expect(body.meta.total).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get household",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/households/{{household_id}}",
            "description": "Read the record created by the first request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('JSON content type', function () { pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json'); });",
                  "pm.test('Stored household', function () { const household = pm.response.json().data; pm.expect(household.id).to.eql(pm.collectionVariables.get('household_id')); pm.expect(household.owner_name).to.eql('Ayu'); pm.expect(household.address).to.eql('Jl. Merdeka 1'); });"
                ]
              }
            }
