        {
          "name": "Unsupported health method",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/healthz",
            "description": "The health endpoint accepts GET and HEAD only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 405', function () { pm.response.to.have.status(405); });",
                  "pm.test('Allowed methods', function () { pm.expect(pm.response.headers.get('Allow')).to.eql('GET, HEAD'); });",
